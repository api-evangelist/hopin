{
  "opencollection": "1.0.0",
  "info": {
    "name": "RingCentral Events Bank Questions Health API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.events.ringcentral.com/v1/health",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.events.ringcentral.com/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Use this endpoint for checking health of API service"
        }
      ]
    }
  ],
  "bundled": true
}